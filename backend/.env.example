# Copy to .env and adjust as needed.

# "auto" (default) uses the real SAM-Audio model if the sam_audio package is
# installed, otherwise falls back to a mock DSP engine for local UI testing.
# Force with "sam_audio" or "mock".
SAM_AUDIO_ENGINE=auto

# Any facebook/sam-audio-{small,base,large}[-tv] checkpoint. Requires gated
# HuggingFace access (`hf auth login`) the first time it's downloaded.
SAM_AUDIO_MODEL_NAME=facebook/sam-audio-base

# "auto" | "cuda" | "cpu"
SAM_AUDIO_DEVICE=auto

SAM_AUDIO_STORAGE_DIR=storage
SAM_AUDIO_MAX_UPLOAD_MB=50
SAM_AUDIO_MAX_AUDIO_SECONDS=60

SAM_AUDIO_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
